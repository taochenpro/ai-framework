# Copy this file to config/automation.env and customize it for a concrete project.
# Keep secrets out of this file.

# Example commands:
# FORMAT_CHECK_CMD="npm run format:check"
# LINT_CMD="npm run lint"
# TYPECHECK_CMD="npm run typecheck"
# TEST_CMD="npm test"
# BUILD_CMD="npm run build"
# SECURITY_CHECK_CMD="npm audit --audit-level=high"

FORMAT_CHECK_CMD=""
LINT_CMD=""
TYPECHECK_CMD=""
TEST_CMD=""
BUILD_CMD=""
SECURITY_CHECK_CMD=""

# Local hook behavior.
REQUIRE_SOURCE_TEST_PAIR=1

# CI requirements. Set to 1 after a command is configured.
REQUIRE_FORMAT=0
REQUIRE_LINT=0
REQUIRE_TYPECHECK=0
REQUIRE_TESTS=0
REQUIRE_BUILD=0
REQUIRE_SECURITY_CHECK=0


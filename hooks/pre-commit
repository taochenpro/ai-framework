#!/usr/bin/env sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

CONFIG="${FRAMEWORK_AUTOMATION_ENV:-config/automation.env}"
if [ -f "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
fi

fail() {
  echo "pre-commit: $*" >&2
  exit 1
}

run_if_set() {
  name="$1"
  command="$2"
  if [ -n "$command" ]; then
    echo "pre-commit: running $name"
    sh -c "$command"
  else
    echo "pre-commit: skipping $name; no command configured"
  fi
}

git diff --cached --check || fail "staged changes contain whitespace errors"

staged_files="$(git diff --cached --name-only --diff-filter=ACM || true)"
for file in $staged_files; do
  if [ -f "$file" ] && grep -n -E '^(<<<<<<<|=======|>>>>>>>)' "$file" >/dev/null 2>&1; then
    fail "merge conflict marker found in $file"
  fi
done

source_changed="$(printf '%s\n' "$staged_files" | grep '^src/' || true)"
test_changed="$(printf '%s\n' "$staged_files" | grep '^tests/' || true)"

if [ "${REQUIRE_SOURCE_TEST_PAIR:-1}" = "1" ] && [ -n "$source_changed" ] && [ -z "$test_changed" ]; then
  fail "source changes under src/ require related test changes under tests/ or REQUIRE_SOURCE_TEST_PAIR=0"
fi

run_if_set "format check" "${FORMAT_CHECK_CMD:-}"
run_if_set "lint" "${LINT_CMD:-}"
run_if_set "tests" "${TEST_CMD:-}"

echo "pre-commit: passed"


#!/usr/bin/env sh
set -eu

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

CONFIG="${FRAMEWORK_AUTOMATION_ENV:-config/automation.env}"
if [ -f "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
fi

fail() {
  echo "ci-check: $*" >&2
  exit 1
}

run_step() {
  name="$1"
  command="$2"
  required="$3"

  if [ -n "$command" ]; then
    echo "ci-check: running $name"
    sh -c "$command"
  elif [ "$required" = "1" ]; then
    fail "$name is required but no command is configured"
  else
    echo "ci-check: skipping $name; no command configured"
  fi
}

for required_file in AGENTS.md memory/tasks.yaml docs/requirements.md docs/architecture.md docs/testing-strategy.md; do
  [ -f "$required_file" ] || fail "missing required framework file: $required_file"
done

run_step "format check" "${FORMAT_CHECK_CMD:-}" "${REQUIRE_FORMAT:-0}"
run_step "lint" "${LINT_CMD:-}" "${REQUIRE_LINT:-0}"
run_step "typecheck" "${TYPECHECK_CMD:-}" "${REQUIRE_TYPECHECK:-0}"
run_step "tests" "${TEST_CMD:-}" "${REQUIRE_TESTS:-0}"
run_step "build" "${BUILD_CMD:-}" "${REQUIRE_BUILD:-0}"
run_step "security check" "${SECURITY_CHECK_CMD:-}" "${REQUIRE_SECURITY_CHECK:-0}"

echo "ci-check: passed"


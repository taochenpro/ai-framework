#!/usr/bin/env sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

mkdir -p memory

timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
commit="$(git rev-parse --short HEAD)"
subject="$(git log -1 --pretty=%s)"

{
  echo ""
  echo "## $timestamp"
  echo "- Commit: $commit"
  echo "- Summary: $subject"
  echo "- Follow-up: update task status in memory/tasks.yaml if this commit changes delivery state."
} >> memory/progress.md

echo "post-commit: appended commit summary to memory/progress.md"

